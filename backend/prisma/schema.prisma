generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  MANAGER
  STAFF
}

model User {
  id       String  @id @default(uuid())
  name     String
  email    String  @unique
  password String
  role     Role    @default(MANAGER)
  isActive Boolean @default(true)

  refreshTokens RefreshToken[]
  activityLogs  ActivityLog[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique // Hashed
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Branch {
  id             String  @id @default(uuid())
  name           String
  nameAm         String? // Amharic translation
  label          String?
  labelAm        String? // Amharic translation
  address        String
  phone          String
  email          String?
  workingHours   String // E.g., "Mon-Sun: 7:00 AM - 11:00 PM"
  workingHoursAm String? // Amharic translation
  note           String?
  noteAm         String? // Amharic translation
  imageUrl       String?
  capacity       Int     @default(50)

  reservations  Reservation[]
  menuItems     MenuItem[]
  eventBookings EventBooking[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model Category {
  id     String  @id @default(uuid())
  name   String  @unique
  nameAm String? // Amharic translation
  order  Int     @default(0)

  // Self-relation for one level of nesting (e.g. "Drinks" > "Hot Drinks").
  // Top-level categories have parentId = null.
  parentId String?
  parent   Category?  @relation("CategoryChildren", fields: [parentId], references: [id])
  children Category[] @relation("CategoryChildren")

  menuItems MenuItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model MenuItem {
  id            String  @id @default(uuid())
  name          String
  nameAm        String? // Amharic translation
  description   String?
  descriptionAm String? // Amharic translation
  price         String
  imageUrl    String?
  tag         String? // e.g. "Signature", "Spicy"
  isAvailable Boolean @default(true)
  order       Int     @default(0)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  branchId String? // If null, available at all branches
  branch   Branch? @relation(fields: [branchId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model GalleryItem {
  id            String  @id @default(uuid())
  title         String?
  titleAm       String? // Amharic translation
  description   String?
  descriptionAm String? // Amharic translation
  imageUrl      String
  thumbUrl      String?
  span          String  @default("col-span-1 row-span-1") // For UI grid
  group         String  @default("MOMENTS") // Section grouping: MOMENTS | LIFE
  alt           String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  NO_SHOW
  COMPLETED
}

model Reservation {
  id             String            @id @default(uuid())
  customerName   String
  phone          String
  email          String?
  date           String // YYYY-MM-DD
  time           String // HH:MM
  partySize      Int
  specialRequest String?
  status         ReservationStatus @default(PENDING)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

enum EventType {
  WEDDING
  ENGAGEMENT
  HALL_RENTAL
  CATERING
  CORPORATE
  BIRTHDAY
  VIP
  VVIP
  OTHER
}

// Bookings/inquiries for events & premium services (weddings, catering,
// hall rental, VIP/VVIP experiences). Separate from table Reservations.
model EventBooking {
  id           String            @id @default(uuid())
  customerName String
  phone        String
  email        String?
  serviceType  EventType
  eventDate    String // YYYY-MM-DD (preferred date)
  guestCount   Int?
  message      String?
  status       ReservationStatus @default(PENDING)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

enum ContactStatus {
  UNREAD
  READ
  REPLIED
}

model ContactMessage {
  id      String        @id @default(uuid())
  name    String
  email   String
  phone   String?
  subject String?
  message String
  status  ContactStatus @default(UNREAD)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

// Guest testimonials shown in the "What Our Guests Say" section.
model Testimonial {
  id       String  @id @default(uuid())
  name     String
  role     String? // e.g. "Food Writer, Addis Fortune"
  roleAm   String?
  quote    String
  quoteAm  String?
  imageUrl String? // guest photo; falls back to initials avatar if empty
  rating   Int     @default(5)
  order    Int     @default(0)
  isActive Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model WebsiteSetting {
  id    String @id @default(uuid())
  key   String @unique
  value String // Could be JSON string

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ActivityLog {
  id     String @id @default(uuid())
  action String // Human readable sentence: "Manager Aster removed 'Doro Wat'"

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}
