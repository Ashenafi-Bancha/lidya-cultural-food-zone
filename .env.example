# Local Docker database settings — copy this file to `.env` (same folder) and
# keep the values identical to the DATABASE_URL in backend/.env:
#
#   postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:<POSTGRES_PORT>/<POSTGRES_DB>?schema=public

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=lidyaculturalfood
# 5434 avoids clashing with a natively-installed PostgreSQL on 5432.
POSTGRES_PORT=5434

# Optional pgAdmin UI (docker compose --profile tools up -d) → http://localhost:5050
PGADMIN_EMAIL=admin@lidya.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
